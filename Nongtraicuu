def random_npc_name():
    """Sinh tên NPC ngẫu nhiên kiểu Việt Nam."""
    if random.random() < 0.5:
        return f"{random.choice(TITLES)} {random.choice(HO)} {random.choice(TEN)}"
    return f"{random.choice(TITLES)} {random.choice(HO)} {random.choice(DEM)} {random.choice(TEN)}"


# ==================== LỚP ĐỐI TƯỢNG ====================

class Slot:
    """Một ô đất trên nông trại: trống / cây trồng / chuồng vật nuôi."""
    __slots__ = ("kind", "name", "progress", "ready")

    def __init__(self):
        self.kind = None       # None | 'crop' | 'animal'
        self.name = None
        self.progress = 0.0
        self.ready = False


class Customer:
    """Khách NPC với một đơn hàng."""
    def __init__(self, name, order, reward, patience):
        self.name = name
        self.order = order          # dict: tên_sản_phẩm -> số lượng
        self.reward = reward
        self.patience = patience
        self.max_patience = patience


# ==================== GAME ====================

class FarmGame:
    COLS, ROWS = 4, 3
    SLOT_W, SLOT_H = 146, 130
    GAP_X, GAP_Y = 12, 16
    ORIGIN_X, ORIGIN_Y = 40, 200
    CANVAS_W, CANVAS_H = 700, 660

    def __init__(self, root, farm_name, theme_key):
        self.root = root
        self.farm_name = farm_name
        self.theme = THEMES[theme_key]

        self.money = 500
        self.inventory = {}          # tên -> số lượng (hạt giống, con giống, sản phẩm)
        self.slots = [Slot() for _ in range(self.COLS * self.ROWS)]
        self.customers = []
        self.reputation = 5.0        # 0..10
        self.ad_time = 0.0           # giây quảng cáo còn hiệu lực
        self.spawn_cd = 4.0
        self.t = 0.0
        self.last = time.time()
        self.status = "Chào mừng đến với nông trại! Hãy mua hạt giống ở Cửa hàng."

        self._build_ui()
        self.tick()

