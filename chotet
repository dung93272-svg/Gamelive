<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Chợ Tết Quê Em 🧧</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-family:'Segoe UI',system-ui,-apple-system,sans-serif}
body{
  background:radial-gradient(ellipse at 50% -10%,#c1121f 0%,#8b0000 45%,#4a0000 100%);
  color:#ffe9c4;user-select:none;
}
#fx{position:fixed;inset:0;pointer-events:none;z-index:1}
#app{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;overflow:hidden}

/* ===== DECOR ===== */
.decor-top{position:fixed;top:0;left:0;right:0;height:0;z-index:3;pointer-events:none}
.lantern{position:absolute;top:-10px;font-size:clamp(28px,5vw,46px);animation:sway 3.5s ease-in-out infinite;filter:drop-shadow(0 0 14px rgba(255,180,60,.85))}
.lantern:nth-child(1){left:4%;animation-delay:0s}
.lantern:nth-child(2){left:22%;animation-delay:.6s;font-size:clamp(20px,3.4vw,32px)}
.lantern:nth-child(3){right:22%;animation-delay:1.1s;font-size:clamp(20px,3.4vw,32px)}
.lantern:nth-child(4){right:4%;animation-delay:.3s}
@keyframes sway{0%,100%{transform:rotate(-7deg)}50%{transform:rotate(7deg)}}

/* ===== SCREENS ===== */
.screen{display:none;height:100%;flex-direction:column;overflow:hidden}
.screen.active{display:flex}

/* ===== INTRO ===== */
#screen-intro{align-items:center;justify-content:center;padding:16px;overflow-y:auto}
.intro-card{
  width:min(560px,100%);background:linear-gradient(160deg,rgba(120,0,0,.94),rgba(70,0,0,.96));
  border:2px solid #ffcf5c;border-radius:20px;padding:22px 20px 24px;text-align:center;
  box-shadow:0 0 0 4px rgba(255,207,92,.12),0 18px 50px rgba(0,0,0,.65);
  position:relative;overflow:hidden;
}
.intro-card::before{content:'';position:absolute;inset:0;background:
  repeating-linear-gradient(45deg,transparent 0 18px,rgba(255,207,92,.05) 18px 19px);pointer-events:none}
.intro-card h1{
  font-size:clamp(22px,5.5vw,34px);letter-spacing:2px;color:#ffd966;
  text-shadow:0 0 18px rgba(255,180,60,.8),0 3px 0 #6b0000;margin-bottom:4px;
}
.sub{font-size:13px;color:#ffcf9a;opacity:.85;margin-bottom:14px}
.story{
  background:rgba(0,0,0,.28);border-left:3px solid #ffcf5c;border-radius:10px;
  padding:10px 12px;text-align:left;font-size:13.5px;line-height:1.65;margin-bottom:16px;color:#ffe9c4;
}
.story p+p{margin-top:6px}
label{display:block;font-size:13px;color:#ffcf9a;margin-bottom:7px;text-align:left}
#shopNameInput{
  width:100%;padding:12px 14px;border-radius:12px;border:2px solid #ffcf5c;
  background:rgba(0,0,0,.4);color:#fff2d0;font-size:16px;font-weight:600;text-align:center;
  outline:none;transition:.2s;font-family:inherit;
}
#shopNameInput:focus{border-color:#fff;box-shadow:0 0 0 4px rgba(255,207,92,.25)}
#shopNameInput::placeholder{color:#a8776a;font-weight:400}
.suggestions{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin:10px 0 16px}
.chip{
  font-size:11.5px;padding:5px 11px;border-radius:20px;cursor:pointer;
  background:rgba(255,207,92,.14);border:1px solid rgba(255,207,92,.45);color:#ffd98a;transition:.15s;
}
.chip:active{transform:scale(.94);background:rgba(255,207,92,.3)}
.btn-main{
  width:100%;padding:15px;border:none;border-radius:14px;cursor:pointer;
  background:linear-gradient(180deg,#ffd966,#e8a317);color:#6b0000;
  font-size:17px;font-weight:800;letter-spacing:1px;font-family:inherit;
  box-shadow:0 5px 0 #a06d00,0 10px 24px rgba(255,180,60,.35);transition:.1s;
}
.btn-main:active{transform:translateY(4px);box-shadow:0 1px 0 #a06d00}
.btn-main:disabled{filter:grayscale(.7);opacity:.5;cursor:not-allowed}

/* ===== HUD ===== */
.hud{
  display:flex;justify-content:space-between;align-items:center;gap:8px;
  padding:10px 12px;background:rgba(0,0,0,.35);border-bottom:2px solid rgba(255,207,92,.35);
  backdrop-filter:blur(8px);flex-shrink:0;flex-wrap:wrap;
}
.hud-shop{font-size:13px;font-weight:700;color:#ffd966;text-shadow:0 0 10px rgba(255,180,60,.6);
  max-width:42vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hud-right{display:flex;gap:8px;align-items:center}
.hud-money,.hud-time{
  font-size:12.5px;font-weight:700;padding:5px 10px;border-radius:20px;
  background:rgba(255,207,92,.16);border:1px solid rgba(255,207,92,.4);color:#ffe08a;white-space:nowrap;
}
.hud-time.warn{background:rgba(255,80,80,.25);border-color:#ff6b6b;color:#ffb3b3;animation:pulseW .8s infinite}
@keyframes pulseW{50%{opacity:.55}}

/* ===== PREP ===== */
.prep-body{flex:1;display:flex;flex-direction:column;overflow:hidden;min-height:0}
.scene{
  position:relative;height:clamp(96px,17vh,150px);flex-shrink:0;
  background:linear-gradient(180deg,rgba(255,140,60,.13),rgba(0,0,0,.32));
  border-bottom:1px solid rgba(255,207,92,.2);display:flex;align-items:flex-end;
  justify-content:center;gap:14px;padding-bottom:8px;overflow:hidden;
}
.scene::after{content:'🏮  🏮  🏮';position:absolute;top:4px;left:0;right:0;text-align:center;
  font-size:12px;letter-spacing:26px;opacity:.5}
.char{font-size:clamp(40px,10vw,64px);filter:drop-shadow(0 6px 12px rgba(0,0,0,.5));animation:bob 2.4s ease-in-out infinite}
.char.me{animation-delay:.7s}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.speech{
  position:absolute;top:6px;left:50%;transform:translateX(-50%);
  background:rgba(255,250,235,.96);color:#5a0000;font-size:11.5px;font-weight:600;
  padding:6px 13px;border-radius:14px;max-width:92%;text-align:center;line-height:1.35;
  box-shadow:0 4px 14px rgba(0,0,0,.4);
}
.speech::after{content:'';position:absolute;bottom:-6px;left:50%;transform:translateX(-50%);
  border:6px solid transparent;border-top-color:rgba(255,250,235,.96);border-bottom:0}

.panel{flex:1;display:flex;flex-direction:column;min-height:0}
.panel-tabs{display:flex;gap:5px;padding:8px 10px 0;flex-shrink:0}
.tab{
  flex:1;padding:9px 4px;border:1px solid rgba(255,207,92,.4);border-bottom:none;
  border-radius:11px 11px 0 0;background:rgba(0,0,0,.22);color:#d9a86a;
  font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;transition:.15s;
}
.tab.active{background:rgba(255,207,92,.2);color:#ffd966;border-color:#ffcf5c}
.tab-content{
  flex:1;overflow-y:auto;padding:10px;background:rgba(0,0,0,.22);
  border-top:1px solid rgba(255,207,92,.4);-webkit-overflow-scrolling:touch;
}
.tab-content::-webkit-scrollbar{width:5px}
.tab-content::-webkit-scrollbar-thumb{background:rgba(255,207,92,.4);border-radius:3px}

.recipe{
  display:flex;gap:10px;align-items:center;padding:10px;margin-bottom:8px;
  background:rgba(255,255,255,.055);border:1px solid rgba(255,207,92,.25);border-radius:12px;
}
.recipe.disabled{opacity:.42}
.r-icon{font-size:26px;flex-shrink:0;filter:drop-shadow(0 2px 5px rgba(0,0,0,.4))}
.r-info{flex:1;min-width:0}
.r-name{font-size:13px;font-weight:700;color:#ffd966;display:flex;justify-content:space-between;gap:6px}
.r-time{font-size:10.5px;color:#ffb36b;font-weight:600;white-space:nowrap}
.r-needs{display:flex;flex-wrap:wrap;gap:5px;margin:4px 0;font-size:10.5px}
.r-needs span{padding:2px 6px;border-radius:6px;background:rgba(0,0,0,.3)}
.r-needs .ok{color:#8ee68e;border:1px solid rgba(140,230,140,.35)}
.r-needs .no{color:#ff8f8f;border:1px solid rgba(255,120,120,.3)}
.r-out{font-size:10.5px;color:#c9a37a}
.btn-make{
  padding:9px 15px;border-radius:10px;border:none;cursor:pointer;flex-shrink:0;
  background:linear-gradient(180deg,#ffd966,#e0a015);color:#6b0000;font-weight:800;
  font-size:12px;font-family:inherit;box-shadow:0 3px 0 #a06d00;transition:.1s;
}
.btn-make:active{transform:translateY(2px);box-shadow:0 1px 0 #a06d00}
.btn-make:disabled{background:#5a4038;color:#8a7068;box-shadow:0 3px 0 #3a2a24;cursor:not-allowed}

.market-item{
  display:flex;align-items:center;gap:10px;padding:9px 10px;margin-bottom:7px;
  background:rgba(255,255,255,.055);border:1px solid rgba(255,207,92,.25);border-radius:12px;
}
.m-icon{font-size:23px}
.m-info{flex:1;min-width:0}
.m-name{font-size:12.5px;font-weight:700;color:#ffe9c4}
.m-price{font-size:11px;color:#ffb36b}
.m-have{font-size:10.5px;color:#9ad4a0}
.m-btns{display:flex;gap:5px}
.m-btn{
  width:34px;height:34px;border-radius:9px;border:1px solid rgba(255,207,92,.5);
  background:rgba(255,207,92,.14);color:#ffd966;font-size:17px;font-weight:800;
  cursor:pointer;font-family:inherit;transition:.1s;
}
.m-btn:active{transform:scale(.9);background:rgba(255,207,92,.35)}
.m-btn.plus{background:linear-gradient(180deg,#ffd966,#e0a015);color:#6b0000;border:none}

.inv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:8px}
.inv-cell{
  background:rgba(255,255,255,.055);border:1px solid rgba(255,207,92,.25);
  border-radius:11px;padding:10px 6px;text-align:center;
}
.inv-cell .ic{font-size:24px;display:block;margin-bottom:3px}
.inv-cell .in{font-size:10.5px;color:#d9b98a;line-height:1.3}
.inv-cell .iv{font-size:15px;font-weight:800;color:#ffd966}
.inv-cell.empty{opacity:.3}

.prep-footer{
  padding:8px 12px 12px;flex-shrink:0;display:flex;gap:8px;
  background:rgba(0,0,0,.3);border-top:1px solid rgba(255,207,92,.2);
}
.btn-ghost{
  flex:1;padding:12px;border-radius:12px;cursor:pointer;font-family:inherit;
  background:rgba(255,207,92,.14);border:1px solid rgba(255,207,92,.45);
  color:#ffd966;font-weight:700;font-size:13px;transition:.12s;
}
.btn-ghost:active{transform:scale(.97);background:rgba(255,207,92,.3)}
.btn-ghost:disabled{opacity:.35;cursor:not-allowed}

/* ===== NIGHT ===== */
#screen-night{align-items:center;justify-content:center;padding:16px;text-align:center}
.night-wrap{width:min(480px,100%)}
.night-title{font-size:clamp(19px,4.5vw,26px);color:#ffd966;margin-bottom:6px;letter-spacing:1px;
  text-shadow:0 0 20px rgba(255,180,60,.7)}
.night-sub{font-size:12.5px;color:#d9a86a;margin-bottom:18px}
.pot{font-size:clamp(62px,18vw,96px);filter:drop-shadow(0 0 26px rgba(255,140,40,.85));
  animation:potbob 1.6s ease-in-out infinite;display:inline-block}
@keyframes potbob{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-9px) scale(1.05)}}
.fire-bar-wrap{
  height:20px;border-radius:12px;background:rgba(0,0,0,.45);overflow:hidden;
  border:2px solid rgba(255,207,92,.4);margin:18px 0 8px;position:relative;
}
#fireBar{
  height:100%;width:100%;border-radius:10px;transition:width .18s linear;
  background:linear-gradient(90deg,#ff3d00,#ff9100,#ffd54f);
  box-shadow:0 0 18px rgba(255,140,40,.9) inset;
}
.fire-label{display:flex;justify-content:space-between;font-size:11px;color:#ffb36b;margin-bottom:10px}
.night-log{
  height:70px;overflow:hidden;font-size:12px;color:#ffcf9a;line-height:1.7;
  background:rgba(0,0,0,.3);border-radius:11px;padding:9px;margin-bottom:12px;
  border:1px solid rgba(255,207,92,.2);
}
.night-log div{animation:slideIn .35s ease}
@keyframes slideIn{from{opacity:0;transform:translateX(-12px)}to{opacity:1;transform:none}}
#btnFire{width:100%;margin-bottom:9px;font-size:15px;padding:16px}
.night-time{font-size:13px;color:#ffd966;font-weight:700;margin-top:8px}

/* ===== SELL ===== */
.sell-body{flex:1;display:flex;flex-direction:column;overflow:hidden;min-height:0}
.market-scene{
  height:clamp(84px,15vh,124px);flex-shrink:0;position:relative;overflow:hidden;
  background:linear-gradient(180deg,#2a0a0a 0%,#5a1010 55%,#7a1a1a 100%);
  display:flex;align-items:center;justify-content:center;gap:18px;
  border-bottom:1px solid rgba(255,207,92,.25);
}
.stall{font-size:clamp(38px,9vw,58px);filter:drop-shadow(0 5px 12px rgba(0,0,0,.6))}
.stall-label{
  position:absolute;top:6px;left:50%;transform:translateX(-50%);
  font-size:11px;font-weight:800;color:#ffd966;background:rgba(180,0,0,.85);
  padding:4px 14px;border-radius:8px;border:1px solid #ffcf5c;white-space:nowrap;
  max-width:90%;overflow:hidden;text-overflow:ellipsis;letter-spacing:.5px;
}
.queue{flex:1;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:8px}
.queue::-webkit-scrollbar{width:5px}
.queue::-webkit-scrollbar-thumb{background:rgba(255,207,92,.4);border-radius:3px}
.customer{
  display:flex;gap:10px;align-items:center;padding:9px 10px;border-radius:13px;
  background:linear-gradient(100deg,rgba(255,207,92,.13),rgba(255,255,255,.05));
  border:1px solid rgba(255,207,92,.35);position:relative;overflow:hidden;
  animation:custIn .3s cubic-bezier(.34,1.56,.64,1);
}
@keyframes custIn{from{opacity:0;transform:translateX(40px) scale(.9)}to{opacity:1;transform:none}}
.customer.leaving{animation:custOut .3s ease forwards}
@keyframes custOut{to{opacity:0;transform:translateX(-60px);height:0;padding:0;margin:0}}
.c-face{font-size:29px;flex-shrink:0;filter:drop-shadow(0 3px 6px rgba(0,0,0,.4))}
.c-info{flex:1;min-width:0}
.c-name{font-size:12.5px;font-weight:800;color:#ffd966;display:flex;align-items:center;gap:5px}
.c-role{font-size:10px;color:#c9a37a;font-style:italic}
.c-want{font-size:11.5px;color:#ffe9c4;margin-top:2px}
.c-patience{
  height:4px;border-radius:3px;background:rgba(0,0,0,.45);margin-top:5px;overflow:hidden;
}
.c-patience i{display:block;height:100%;background:linear-gradient(90deg,#4caf50,#ffeb3b,#ff5722);
  background-size:300% 100%;background-position:0 0;transition:width .15s linear}
.btn-serve{
  padding:9px 14px;border-radius:10px;border:none;cursor:pointer;flex-shrink:0;
  background:linear-gradient(180deg,#7ee87e,#2fa32f);color:#04380b;font-weight:800;
  font-size:12px;font-family:inherit;box-shadow:0 3px 0 #1a6b1a;transition:.1s;
}
.btn-serve:active{transform:translateY(2px);box-shadow:0 1px 0 #1a6b1a}
.empty-queue{text-align:center;color:#a8776a;font-size:12.5px;padding:28px 10px;line-height:1.7}
.float-money{
  position:fixed;font-weight:800;font-size:15px;color:#8eff8e;pointer-events:none;z-index:99;
  text-shadow:0 2px 8px rgba(0,0,0,.85);animation:floatUp 1.1s ease-out forwards;
}
.float-money.lucky{color:#ffd966;font-size:18px;text-shadow:0 0 14px rgba(255,200,60,.95),0 2px 8px #000}
@keyframes floatUp{0%{opacity:1;transform:translateY(0) scale(.8)}25%{transform:translateY(-16px) scale(1.15)}
  100%{opacity:0;transform:translateY(-62px) scale(1)}}

/* ===== REPORT ===== */
#screen-report{overflow-y:auto;padding:16px;align-items:center}
.report-card{
  width:min(520px,100%);background:linear-gradient(160deg,rgba(120,0,0,.95),rgba(60,0,0,.97));
  border:2px solid #ffcf5c;border-radius:18px;padding:18px;margin:auto;
  box-shadow:0 0 0 4px rgba(255,207,92,.12),0 16px 46px rgba(0,0,0,.7);
}
.report-card h2{text-align:center;color:#ffd966;font-size:19px;margin-bottom:3px;letter-spacing:1px}
.report-sub{text-align:center;font-size:11.5px;color:#d9a86a;margin-bottom:15px}
.stat-row{
  display:flex;justify-content:space-between;padding:9px 11px;border-radius:9px;
  font-size:13px;margin-bottom:6px;background:rgba(0,0,0,.25);
}
.stat-row.total{
  background:linear-gradient(90deg,rgba(255,207,92,.28),rgba(255,207,92,.13));
  border:1px solid #ffcf5c;font-weight:800;font-size:15px;color:#ffd966;margin-top:9px;
}
.stat-row .v{font-weight:800}
.stat-row .v.plus{color:#8eff8e}
.stat-row .v.minus{color:#ff9a9a}
.sold-list{margin:11px 0;font-size:12px}
.sold-list .h{color:#ffd966;font-weight:800;margin-bottom:6px}
.sold-item{display:flex;justify-content:space-between;padding:5px 10px;border-radius:7px;
  background:rgba(0,0,0,.2);margin-bottom:4px;color:#e8d0aa}
.rank{
  text-align:center;font-size:15px;font-weight:800;padding:12px;border-radius:12px;
  margin:14px 0;background:linear-gradient(135deg,rgba(255,207,92,.22),rgba(255,140,40,.12));
  border:1px solid rgba(255,207,92,.5);color:#ffd966;line-height:1.5;
}
.rank small{display:block;font-size:11.5px;font-weight:500;color:#d9b98a;margin-top:5px}
.grandma-say{
  background:rgba(255,250,235,.95);color:#5a0000;border-radius:12px;padding:11px 13px;
  font-size:12.5px;line-height:1.6;margin-bottom:14px;font-weight:600;
}
</style>
</head>
<body>
<canvas id="fx"></canvas>
<div class="decor-top">
  <div class="lantern">🏮</div><div class="lantern">🏮</div>
  <div class="lantern">🏮</div><div class="lantern">🏮</div>
</div>

<div id="app">

  <!-- ========== INTRO ========== -->
  <section id="screen-intro" class="screen active">
    <div class="intro-card">
      <div style="font-size:26px;margin-bottom:6px">🏮 🧧 🏮</div>
      <h1>CHỢ TẾT QUÊ EM</h1>
      <p class="sub">Cháu từ thành phố về quê ăn Tết, phụ bà bán hàng</p>
      <div class="story">
        <p>👵 <b>Bà:</b> "Cháu về rồi à! Năm nay bà yếu quá, cháu giúp bà gói bánh, ra chợ bán Tết nhé!"</p>
        <p>🧑 <b>Cháu:</b> "Vâng ạ! Bà cứ nghỉ ngơi, để cháu lo hết!"</p>
        <p>👵 <b>Bà:</b> "Đây, bà có 500.000đ, cháu cầm lấy mà sắm đồ. Tết nhất phải tươm tất nghe con."</p>
      </div>
      <label>🏮 Đặt tên gian hàng của bạn:</label>
      <input id="shopNameInput" maxlength="22" placeholder="Nhập tên gian hàng...">
      <div class="suggestions">
        <span class="chip">Gian Hàng Bà Tư</span>
        <span class="chip">Tết Quê Ngoại</span>
        <span class="chip">Bánh Chưng Cô Ba</span>
        <span class="chip">Chợ Tết Xóm Mít</span>
        <span class="chip">Gánh Hàng Ngày Tết</span>
      </div>
      <button id="btnStart" class="btn-main" disabled>🧧 MỞ HÀNG 🧧</button>
    </div>
  </section>

  <!-- ========== PREP ========== -->
  <section id="screen-prep" class="screen">
    <div class="hud">
      <span class="hud-shop" id="hudShop">🏮 Gian hàng</span>
      <div class="hud-right">
        <span class="hud-money" id="hudMoney">💰 0đ</span>
        <span class="hud-time" id="hudTime">🕐 12:00</span>
      </div>
    </div>
    <div class="prep-body">
      <div class="scene">
        <div class="speech" id="speech">Bà: Cháu mau đi chợ mua đồ về gói bánh nào!</div>
        <div class="char grandma">👵</div>
        <div class="char me">🧑</div>
      </div>
      <div class="panel">
        <div class="panel-tabs">
          <button class="tab active" data-tab="cook">🍳 Nấu nướng</button>
          <button class="tab" data-tab="market">🛒 Đi chợ</button>
          <button class="tab" data-tab="inv">📦 Kho</button>
        </div>
        <div class="tab-content" id="tabContent"></div>
      </div>
    </div>
    <div class="prep-footer">
      <button class="btn-ghost" id="btnRest">😴 Nghỉ 1 giờ</button>
      <button class="btn-ghost" id="btnReady">⏭️ Sẵn sàng qua đêm</button>
    </div>
  </section>

  <!-- ========== NIGHT ========== -->
  <section id="screen-night" class="screen">
    <div class="night-wrap">
      <div class="night-title">🌙 ĐÊM GIAO THỪA 🌙</div>
