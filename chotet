/* =========================================================
   CANVAS FX — cánh hoa + pháo hoa
   ========================================================= */
(function(){
  const cv = $('#fx'), ctx = cv.getContext('2d');
  let W,H;
  function resize(){ W = cv.width = innerWidth; H = cv.height = innerHeight; }
  addEventListener('resize', resize); resize();

  const petals = [];
  function newPetal(init){
    return {
      x: rand(0,W), y: init ? rand(-H,H) : rand(-120,-20),
      s: rand(4,10), vy: rand(.25,1.1), vx: rand(-.35,.35),
      rot: rand(0,Math.PI*2), vr: rand(-.025,.025),
      sway: rand(0,Math.PI*2), swSp: rand(.012,.03),
      c: Math.random()<.55 ? '#ffb7c5' : (Math.random()<.5 ? '#ffd97a' : '#ff8fa3')
    };
  }
  for(let i=0;i<44;i++) petals.push(newPetal(true));

  const sparks = [];
  function firework(){
    const x = rand(W*.12,W*.88), y = rand(H*.08,H*.45);
    const hue = pick([0,40,320,280,15]);
    for(let i=0;i<42;i++){
      const a = (Math.PI*2*i)/42 + rand(-.1,.1), sp = rand(1.4,4.6);
      sparks.push({ x,y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp, life:1,
        c:`hsl(${hue+rand(-18,18)},100%,${rand(58,76)}%)`, r:rand(1.4,2.8) });
    }
  }
  let fwT = rand(2,5);

  let last = performance.now();
  function loop(t){
    const dt = Math.min((t-last)/1000,.05); last = t;
    ctx.clearRect(0,0,W,H);

    // petals
    for(const p of petals){
      p.sway += p.swSp;
      p.x += p.vx + Math.sin(p.sway)*.7;
      p.y += p.vy; p.rot += p.vr;
      if(p.y > H+24){ Object.assign(p, newPetal(false)); }
      if(p.x < -24) p.x = W+20; if(p.x > W+24) p.x = -20;
      ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot);
      ctx.globalAlpha = .75; ctx.fillStyle = p.c;
      ctx.beginPath();
      ctx.ellipse(0,0,p.s,p.s*.6,0,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }
    ctx.globalAlpha = 1;

    // fireworks
    fwT -= dt;
    if(fwT <= 0){ firework(); fwT = rand(3.5,8); }
    for(let i=sparks.length-1;i>=0;i--){
      const s = sparks[i];
      s.x += s.vx; s.y += s.vy; s.vy += .045; s.vx *= .985; s.vy *= .985;
      s.life -= dt*1.05;
      if(s.life <= 0){ sparks.splice(i,1); continue; }
      ctx.globalAlpha = Math.max(0,s.life);
      ctx.fillStyle = s.c;
      ctx.shadowBlur = 10; ctx.shadowColor = s.c;
      ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();

/* =========================================================
   HELPERS
   ========================================================= */
function timeStr(t){
  const h = Math.floor(t) % 24, m = Math.floor((t%1)*60);
  return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0');
}
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  $('#'+id).classList.add('active');
}
function floatText(x, y, text, lucky){
  const d = document.createElement('div');
  d.className = 'float-money' + (lucky?' lucky':'');
  d.textContent = text;
  d.style.left = x+'px'; d.style.top = y+'px';
  document.body.appendChild(d);
  setTimeout(()=>d.remove(), 1150);
}
function say(text){ const e=$('#speech'); if(e) e.textContent = text; }

/* =========================================================
   INTRO
   ========================================================= */
const nameInput = $('#shopNameInput'), btnStart = $('#btnStart');
nameInput.addEventListener('input', () => {
  btnStart.disabled = nameInput.value.trim().length < 2;
});
document.querySelectorAll('.chip').forEach(c => {
  c.addEventListener('click', () => {
    nameInput.value = c.textContent;
    btnStart.disabled = false;
  });
});
btnStart.addEventListener('click', () => {
  G.shopName = nameInput.value.trim() || 'Gian Hàng Tết';
  $('#hudShop').textContent = '🏮 ' + G.shopName;
  $('#sellShop').textContent = '🏮 ' + G.shopName;
  $('#stallLabel').textContent = G.shopName.toUpperCase();
  G.phase = 'prep';
  showScreen('screen-prep');
  renderPrep();
  say('Bà: Cháu mau đi chợ mua đồ về gói bánh nào!');
});

/* =========================================================
   PREP PHASE
   ========================================================= */
let currentTab = 'cook';

document.querySelectorAll('.tab').forEach(t => {
  t.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    currentTab = t.dataset.tab;
    renderTab();
  });
});

function updateHUD(){
  $('#hudMoney').textContent = '💰 ' + fmt(G.money);
  const t = $('#hudTime');
  t.textContent = '🕐 ' + timeStr(G.time);
  t.classList.toggle('warn', G.time >= 21);
}
function renderPrep(){ updateHUD(); renderTab(); }

function renderTab(){
  if(currentTab === 'cook')   renderCook();
  if(currentTab === 'market') renderMarket();
  if(currentTab === 'inv')    renderInv();
}

function canMake(r){
  if(G.time + r.time > 23) return false;
  for(const k in r.needs) if((G.raw[k]||0) < r.needs[k]) return false;
  return true;
}

function renderCook(){
  const el = $('#tabContent');
  el.innerHTML = RECIPES.map(r => {
    const can = canMake(r);
    const needsHTML = Object.entries(r.needs).map(([k,v]) => {
      const ok = (G.raw[k]||0) >= v;
      return `<span class="${ok?'ok':'no'}">${MARKET[k].emoji} ${MARKET[k].name} ${G.raw[k]||0}/${v}</span>`;
    }).join('');
    const outHTML = Object.entries(r.makes).map(([k,v]) => {
      const nm = GOODS[k] ? GOODS[k].name : 'Bánh chưng sống';
      const em = GOODS[k] ? GOODS[k].emoji : '🟩';
      return `${em} ${nm} ×${v}`;
    }).join(', ');
    return `<div class="recipe ${can?'':'disabled'}">
      <div class="r-icon">${r.emoji}</div>
      <div class="r-info">
        <div class="r-name"><span>${r.name}</span><span class="r-time">⏱ ${r.time}h</span></div>
        <div class="r-needs">${needsHTML}</div>
        <div class="r-out">→ ${outHTML}</div>
      </div>
      <button class="btn-make" data-recipe="${r.id}" ${can?'':'disabled'}>Làm</button>
    </div>`;
  }).join('') + `
    <div style="text-align:center;font-size:11px;color:#a8776a;padding:6px 0 4px">
      Thời gian còn lại: <b style="color:#ffd966">${(23-G.time).toFixed(1)}h</b> (đến 23:00)
    </div>`;

  el.querySelectorAll('.btn-make').forEach(b => {
    b.addEventListener('click', () => doRecipe(b.dataset.recipe));
  });
}

function doRecipe(id){
  const r = RECIPES.find(x => x.id === id);
  if(!r || !canMake(r)) return;
  for(const k in r.needs) G.raw[k] -= r.needs[k];
  for(const k in r.makes){
    G.goods[k] = (G.goods[k]||0) + r.makes[k];
    G.stats.made[k] = (G.stats.made[k]||0) + r.makes[k];
  }
  G.time = Math.min(23, G.time + r.time);

  const made = Object.entries(r.makes).map(([k,v]) =>
    (GOODS[k]?GOODS[k].name:'Bánh chưng sống') + ' ×' + v).join(', ');
  say(`🧑 Cháu vừa ${r.name.toLowerCase()} xong! Được ${made}.`);

  updateHUD();
  renderTab();
  if(G.time >= 23){ setTimeout(startNight, 700); }
}

function renderMarket(){
  const el = $('#tabContent');
  let html = Object.entries(MARKET).map(([k,m]) => `
    <div class="market-item">
      <span class="m-icon">${m.emoji}</span>
      <div class="m-info">
        <div class="m-name">${m.name}</div>
        <div class="m-price">${fmt(m.price)} <span class="m-have">· đang có ${G.raw[k]||0}</span></div>
      </div>
      <div class="m-btns">
        <button class="m-btn" data-buy="${k}" data-q="-1">−</button>
        <button class="m-btn plus" data-buy="${k}" data-q="1">+</button>
      </div>
    </div>`).join('');

  html += `
    <div class="market-item" style="border-color:#ffcf5c;background:rgba(255,207,92,.1)">
      <span class="m-icon">${DECOR.emoji}</span>
      <div class="m-info">
        <div class="m-name">${DECOR.name}</div>
        <div class="m-price">${fmt(DECOR.price)} <span class="m-have">· trang trí: ${G.decor}</span></div>
      </div>
      <div class="m-btns">
        <button class="m-btn plus" data-decor="1">+</button>
      </div>
    </div>
    <div style="text-align:center;font-size:11px;color:#a8776a;padding:8px 0">
      🌸 Hoa đào giúp gian hàng đông khách hơn!
    </div>`;

  el.innerHTML = html;

  el.querySelectorAll('[data-buy]').forEach(b => {
    b.addEventListener('click', () => {
      const k = b.dataset.buy, q = +b.dataset.q;
      if(q > 0){
        if(G.money < MARKET[k].price){ say('👵 Bà: Hết tiền rồi cháu ơi, tính toán cho kỹ!'); return; }
        G.money -= MARKET[k].price; G.stats.spent += MARKET[k].price;
        G.raw[k] = (G.raw[k]||0) + 1;
      } else {
        if((G.raw[k]||0) <= 0) return;
        G.raw[k]--; G.money += Math.floor(MARKET[k].price*0.7); // bán lại lỗ
      }
      updateHUD(); renderMarket();
    });
  });
  el.querySelectorAll('[data-decor]').forEach(b => {
    b.addEventListener('click', () => {
      if(G.money < DECOR.price){ say('👵 Bà: Hoa đắt quá, thôi để dành tiền mua thịt!'); return; }
      G.money -= DECOR.price; G.stats.spent += DECOR.price; G.decor++;
      updateHUD(); renderMarket();
    });
  });
}

function renderInv(){
  const el = $('#tabContent');
  let html = '<div class="inv-grid">';
  for(const k in MARKET){
    const has = G.raw[k]||0;
    html += `<div class="inv-cell ${has?'':'empty'}">
      <span class="ic">${MARKET[k].emoji}</span>
      <span class="in">${MARKET[k].name}</span>
      <span class="iv">${has}</span>
    </div>`;
  }
  for(const k in GOODS){
    const has = G.goods[k]||0;
    html += `<div class="inv-cell ${has?'':'empty'}">
      <span class="ic">${GOODS[k].emoji}</span>
      <span class="in">${GOODS[k].name}</span>
      <span class="iv">${has}</span>
    </div>`;
  }
  html += `<div class="inv-cell ${G.goods.banhchung_raw?'':'empty'}">
      <span class="ic">🟩</span><span class="in">Bánh chưng sống</span>
      <span class="iv">${G.goods.banhchung_raw}</span></div>`;
  html += `<div class="inv-cell ${G.decor?'':'empty'}">
      <span class="ic">🌸</span><span class="in">Hoa đào</span>
      <span class="iv">${G.decor}</span></div>`;
  html += '</div>';
  el.innerHTML = html;
}

$('#btnRest').addEventListener('click', () => {
  G.time = Math.min(23, G.time + 1);
  say(pick([
    '🧑 Cháu tranh thủ nghỉ một chút...',
    '👵 Bà: Nghỉ tay đi cháu, còn nhiều việc lắm đó.',
    '🧑 Cháu ngồi ngắm cây mai trước sân.',
  ]));
