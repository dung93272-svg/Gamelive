  if(G.time >= 23) setTimeout(startNight, 700);
});

$('#btnReady').addEventListener('click', startNight);

/* =========================================================
   NIGHT PHASE
   ========================================================= */
const night = { fire:100, running:false, t:23, last:0, damage:0, spoiled:0 };

function startNight(){
  if(G.phase === 'night') return;
  G.phase = 'night';
  G.time = 23;
  night.fire = 100; night.running = true; night.t = 23; night.damage = 0; night.spoiled = 0;
  night.last = performance.now();
  $('#nightLog').innerHTML = '';
  $('#fireBar').style.width = '100%';
  $('#firePct').textContent = '100%';
  $('#nightTime').textContent = '🕐 23:00';
  $('#potIcon').textContent = '🍲';
  showScreen('screen-night');
  logNight('🔥 Bà nhóm lửa, cháu canh nồi bánh chưng...');
  setTimeout(()=>logNight('🟩 Đang luộc ' + G.goods.banhchung_raw + ' chiếc bánh chưng'), 900);
}

function logNight(msg){
  const el = $('#nightLog');
  const d = document.createElement('div');
  d.textContent = msg;
  el.appendChild(d);
  if(el.children.length > 4) el.removeChild(el.firstChild);
  el.scrollTop = el.scrollHeight;
}

$('#btnFire').addEventListener('click', () => {
  if(!night.running) return;
  night.fire = Math.min(100, night.fire + 32);
  $('#fireBar').style.width = night.fire + '%';
  $('#firePct').textContent = Math.round(night.fire) + '%';
  const btn = $('#btnFire');
  btn.style.transform = 'scale(.94)';
  setTimeout(()=>btn.style.transform='', 90);
});

$('#btnSkipNight').addEventListener('click', () => {
  night.running = false;
  finishNight(true);
});

function updateNight(dt){
  if(!night.running) return;
  night.t += dt * (6/16); // 6 giờ game trong ~16s thật
  night.fire -= dt * 5.2;

  if(night.fire <= 0){
    night.fire = 0;
    night.damage += dt;
    if(night.damage > 1.1){
      night.damage = 0;
      if(G.goods.banhchung_raw > 0){
        G.goods.banhchung_raw--;
        night.spoiled++;
        logNight('⚠️ Lửa tắt! Một chiếc bánh bị sống...');
      }
    }
  } else if(night.fire < 25 && Math.random() < dt*1.6){
    logNight(pick(['🔥 Lửa yếu rồi, thêm củi mau!','💨 Khói bay nghi ngút...','🪵 Củi sắp hết!']));
  }

  $('#fireBar').style.width = Math.max(0,night.fire) + '%';
  $('#firePct').textContent = Math.round(Math.max(0,night.fire)) + '%';
  $('#nightTime').textContent = '🕐 ' + timeStr(Math.min(29, night.t));
  $('#potIcon').textContent = night.fire > 50 ? '🍲' : (night.fire > 15 ? '♨️' : '🥶');

  if(night.t >= 28.6 && Math.random() < dt*2.5){
    logNight(pick(['🌾 Mùi bánh chưng thơm phức...','🌙 Ngoài trời yên tĩnh, chỉ nghe tiếng củi nổ.','⭐ Sao đêm giao thừa sáng lắm.']));
  }
  if(night.t >= 29){ night.running = false; finishNight(false); }
}

function finishNight(skipped){
  const raw = G.goods.banhchung_raw;
  G.goods.banhchung += raw;
  G.goods.banhchung_raw = 0;
  showScreen('screen-prep'); // tạm
  // chuyển sang bán hàng
  setTimeout(() => {
    if(raw > 0) logNight('✅ Bánh chưng chín rồi!');
    startSell(raw, night.spoiled, skipped);
  }, 250);
}

/* =========================================================
   SELL PHASE
   ========================================================= */
const sell = {
  running:false, t:5, customers:[], spawnT:0, last:0, uid:0, ended:false
};

function startSell(boiled, spoiled, skipped){
  G.phase = 'sell';
  sell.running = true; sell.t = 5; sell.customers = []; sell.spawnT = 0.6;
  sell.last = performance.now(); sell.uid = 0; sell.ended = false;
  $('#queue').innerHTML = '<div class="empty-queue">Chợ còn vắng...<br>Khách sẽ tới ngay thôi!</div>';
  $('#sellMoney').textContent = '💰 ' + fmt(G.money);
  $('#sellTime').textContent = '🕐 05:00';
  showScreen('screen-sell');
  if(boiled > 0){
    setTimeout(()=>flashQueue(`🟩 ${boiled} chiếc bánh chưng đã chín vàng!`), 300);
  }
}

function flashQueue(msg){
  const el = $('#queue');
  if(el.querySelector('.empty-queue')) el.innerHTML = '';
  const d = document.createElement('div');
  d.style.cssText = 'text-align:center;font-size:12px;color:#ffd966;padding:8px;background:rgba(255,207,92,.12);border-radius:10px;border:1px dashed rgba(255,207,92,.45)';
  d.textContent = msg;
  el.prepend(d);
  setTimeout(()=>d.remove(), 2600);
}

function availableGoods(){
  return Object.keys(GOODS).filter(k => (G.goods[k]||0) > 0);
}

function spawnCustomer(){
  const avail = availableGoods();
  if(avail.length === 0) return;

  const nItems = Math.min(avail.length, ri(1,2));
  const shuffled = avail.sort(()=>Math.random()-.5).slice(0, nItems);
  const wants = [];
  for(const k of shuffled){
    const maxQ = Math.min(G.goods[k], 3);
    if(maxQ > 0) wants.push({ id:k, qty: ri(1, Math.max(1,maxQ)) });
  }
  if(!wants.length) return;

  const isRich = Math.random() < 0.12;
  const c = {
    uid: ++sell.uid,
    face: pick(FACES),
    name: pick(FIRST) + ' ' + pick(LAST),
    role: isRich ? 'khách sộp 🤑' : pick(ROLES),
    wants,
    patience: 1,
    speed: rand(0.055, 0.11) * (isRich ? 1.35 : 1),
    rich: isRich,
    el: null,
  };
  sell.customers.push(c);
  renderQueue();
}

function renderQueue(){
  const q = $('#queue');
  const empt = q.querySelector('.empty-queue');
  if(sell.customers.length === 0){
    if(!empt){
      q.innerHTML = '<div class="empty-queue">Chợ còn vắng...<br>Khách sẽ tới ngay thôi!</div>';
    }
    return;
  }
  if(empt) empt.remove();

  // rebuild
  q.innerHTML = '';
  for(const c of sell.customers){
    const wantHTML = c.wants.map(w =>
      `${GOODS[w.id].emoji} ${GOODS[w.id].name} ×${w.qty}`).join(' &nbsp;·&nbsp; ');
    const el = document.createElement('div');
    el.className = 'customer';
    el.dataset.uid = c.uid;
    el.innerHTML = `
      <span class="c-face">${c.face}</span>
      <div class="c-info">
        <div class="c-name">${c.name}${c.rich?' 💰':''}</div>
        <div class="c-role">${c.role}</div>
        <div class="c-want">${wantHTML}</div>
        <div class="c-patience"><i style="width:${c.patience*100}%"></i></div>
      </div>
      <button class="btn-serve" data-uid="${c.uid}">Bán</button>`;
    q.appendChild(el);
    c.el = el;
  }
  q.querySelectorAll('.btn-serve').forEach(b => {
    b.addEventListener('click', e => serveCustomer(+b.dataset.uid, e));
  });
}

function serveCustomer(uid, ev){
  const idx = sell.customers.findIndex(c => c.uid === uid);
  if(idx < 0) return;
  const c = sell.customers[idx];

  let total = 0, soldAny = false, soldLines = [];
  for(const w of c.wants){
    const have = G.goods[w.id] || 0;
    const q = Math.min(have, w.qty);
    if(q <= 0) continue;
    G.goods[w.id] -= q;
    const gain = q * GOODS[w.id].price;
    total += gain;
    soldAny = true;
    G.stats.soldCounts[w.id] = (G.stats.soldCounts[w.id]||0) + q;
    soldLines.push(`${GOODS[w.id].emoji}${q}`);
  }

  if(!soldAny){
    // không còn hàng -> khách bỏ đi
    removeCustomer(idx, true);
    return;
  }

  G.money += total;
  G.stats.revenue += total;
  G.stats.served++;

  // lì xì
  let lucky = 0;
  const luckyChance = c.rich ? 0.42 : 0.15;
  if(Math.random() < luckyChance){
    lucky = c.rich ? ri(20,60)*1000 : ri(5,20)*1000;
    G.money += lucky;
    G.stats.lucky += lucky;
  }

  const rect = c.el.getBoundingClientRect();
  const x = rect.left + rect.width/2 - 40, y = rect.top + 6;
  floatText(x, y, '+' + fmt(total), false);
  if(lucky > 0){
    setTimeout(() => {
      floatText(x-16, y-14, '🧧 LÌ XÌ +' + fmt(lucky), true);
    }, 260);
  }

  $('#sellMoney').textContent = '💰 ' + fmt(G.money);

  // khách hài lòng -> đi ngay
  removeCustomer(idx, false, true);
}

function removeCustomer(idx, angry, happy){
  const c = sell.customers[idx];
  if(!c) return;
  if(c.el){
    c.el.classList.add('leaving');
    if(angry) c.el.style.borderColor = '#ff6b6b';
  }
  sell.customers.splice(idx, 1);
  if(angry) G.stats.lost++;
  setTimeout(renderQueue, 280);
}

function updateSell(dt){
  if(!sell.running) return;

  // thời gian: 5h -> 12h trong ~30 giây
  sell.t += dt * (7/30);
  $('#sellTime').textContent = '🕐 ' + timeStr(Math.min(12, sell.t));
  $('#sellTime').classList.toggle('warn', sell.t >= 11);

  // spawn
  sell.spawnT -= dt;
  if(sell.spawnT <= 0){
    const base = 1.9;
    const decorBonus = Math.max(0.55, 1 - G.decor * 0.13);
    sell.spawnT = rand(base*0.7, base*1.25) * decorBonus;
    if(sell.customers.length < 6) spawnCustomer();
  }

  // patience
  for(let i = sell.customers.length-1; i >= 0; i--){
    const c = sell.customers[i];
    c.patience -= c.speed * dt;
    if(c.el){
      const bar = c.el.querySelector('.c-patience i');
      if(bar) bar.style.width = Math.max(0, c.patience*100) + '%';
    }
    if(c.patience <= 0){
      // bỏ đi
      if(c.el){
        const r = c.el.getBoundingClientRect();
        floatText(r.left + r.width/2 - 30, r.top + 6, '😤 Bỏ đi', false);
      }
      removeCustomer(i, true);
    }
  }

  if(sell.t >= 12){ sell.running = false; endSell(); }
}

/* =========================================================
   REPORT
   ========================================================= */
function endSell(){
  if(sell.ended) return;
  sell.ended = true;
  G.phase = 'report';

  const revenue = G.stats.revenue + G.stats.lucky;
  const profit = revenue - G.stats.spent;

  // tồn kho
  let leftover = 0, leftoverHTML = '';
  for(const k in GOODS){
    if((G.goods[k]||0) > 0){
      leftover += G.goods[k];
      leftoverHTML += `<div class="sold-item"><span>${GOODS[k].emoji} ${GOODS[k].name}</span><span>còn ${G.goods[k]}</span></div>`;
    }
  }

  // sold list
  let soldHTML = '';
  let bestKey = null, bestQty = 0;
  for(const k in G.stats.soldCounts){
    const q = G.stats.soldCounts[k];
    if(q <= 0) continue;
    if(q > bestQty){ bestQty = q; bestKey = k; }
    soldHTML += `<div class="sold-item">
      <span>${GOODS[k].emoji} ${GOODS[k].name}</span>
      <span>${q} × ${fmt(GOODS[k].price)} = <b style="color:#8eff8e">${fmt(q*GOODS[k].price)}</b></span>
    </div>`;
  }
  if(!soldHTML) soldHTML = '<div class="sold-item" style="justify-content:center;color:#a8776a">Không bán được gì 😢</div>';

  // xếp hạng
  let rank, rankSub;
  if(profit >= 900000){ rank = '🏆 TRẠNG NGUYÊN CHỢ TẾT'; rankSub = 'Bà nở mày nở mặt với cả xóm!'; }
  else if(profit >= 600000){ rank = '🥇 THẦN TÀI BUÔN BÁN'; rankSub = 'Phiên chợ đắt như tôm tươi!'; }
  else if(profit >= 350000){ rank = '🥈 TAY BUÔN CÓ NGHỀ'; rankSub = 'Bà gật gù khen cháu giỏi.'; }
  else if(profit >= 120000){ rank = '🥉 TẠM ĐƯỢC'; rankSub = 'Cũng gọi là có lãi, cố thêm nhé!'; }
  else if(profit >= 0){ rank = '😅 HÒA VỐN'; rankSub = 'Bán được nhưng chưa ăn thua.'; }
  else { rank = '💸 LỖ VỐN'; rankSub = 'Bà cười: "Không sao, Tết mà con!"'; }

  const grandmaLines = [];
  if(profit > 600000) grandmaLines.push('👵 "Cháu bà giỏi quá! Năm sau bà giao cả sạp luôn!"');
  else if(profit > 200000) grandmaLines.push('👵 "Khá lắm! Bán thế này bà yên tâm rồi."');
  else if(profit > 0) grandmaLines.push('👵 "Được rồi cháu, Tết nhất kiếm được chút là vui."');
  else grandmaLines.push('👵 "Thôi không sao, Tết là phải vui. Năm sau làm lại!"');
  if(G.stats.lucky > 0) grandmaLines.push(`🧧 Khách lì xì tổng cộng ${fmt(G.stats.lucky)} — hên quá!`);
  if(leftover > 0) grandmaLines.push(`📦 Còn ${leftover} món chưa bán hết, để dành ăn Tết.`);

  $('#reportCard').innerHTML = `
    <h2>🧾 BÁO CÁO DOANH THU</h2>
    <div class="report-sub">${G.shopName} · Ngày 1 Tết · 05:00 → 12:00</div>

    <div class="stat-row"><span>💵 Tiền bán hàng</span><span class="v plus">${fmt(G.stats.revenue)}</span></div>
    <div class="stat-row"><span>🧧 Khách lì xì</span><span class="v plus">${fmt(G.stats.lucky)}</span></div>
    <div class="stat-row"><span>🛒 Chi phí nguyên liệu</span><span class="v minus">−${fmt(G.stats.spent)}</span></div>
    <div class="stat-row total"><span>💰 LỢI NHUẬN</span><span class="v">${fmt(profit)}</span></div>
    <div class="stat-row"><span>🏦 Tiền mặt còn lại</span><span class="v">${fmt(G.money)}</span></div>
    <div class="stat-row"><span>👥 Khách phục vụ</span><span class="v">${G.stats.served} người</span></div>
    <div class="stat-row"><span>😤 Khách bỏ đi</span><span class="v">${G.stats.lost} người</span></div>

    <div class="sold-list">
      <div class="h">📊 Mặt hàng đã bán</div>
      ${soldHTML}
    </div>

    ${leftoverHTML ? `<div class="sold-list"><div class="h">📦 Tồn kho cuối ngày</div>${leftoverHTML}</div>` : ''}

    <div class="rank">${rank}<small>${rankSub}</small></div>

    <div class="grandma-say">${grandmaLines.join('<br>')}</div>

    <button class="btn-main" id="btnNextDay">🌅 SANG NGÀY MỚI</button>
  `;

  showScreen('screen-report');
  $('#btnNextDay').addEventListener('click', nextDay);
}

function nextDay(){
  // reset nhẹ, giữ tiền, tăng độ khó nhẹ
  G.time = 12;
  G.raw = { gaonep:0,dau:0,thit:0,la:0,lat:0,dua:0,duong:0,hanh:0,giam:0 };
  G.goods = { banhchung_raw:0, banhchung:0, banhgiay:0, mutdua:0, duahang:0, thitdong:0 };
  G.decor = 0;
  G.stats = { revenue:0, spent:0, lucky:0, served:0, lost:0, soldCounts:{}, made:{} };
  G.phase = 'prep';
  showScreen('screen-prep');
  renderPrep();
  say('👵 Bà: Ngày mới rồi, cháu ra chợ sớm nghe!');
}

/* =========================================================
   MAIN LOOP
   ========================================================= */
let lastT = performance.now();
function gameLoop(t){
  const dt = Math.min((t - lastT)/1000, 0.08);
  lastT = t;

  if(G.phase === 'night') updateNight(dt);
  if(G.phase === 'sell')  updateSell(dt);

  requestAnimationFrame(gameLoop);
}
requestAnimationFrame(gameLoop);
</script>
